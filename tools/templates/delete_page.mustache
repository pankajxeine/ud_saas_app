import 'package:flutter/material.dart' hide Scaffold;
import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:ud_sass_app/core/config/environment.dart';
import 'package:ud_sass_app/core/navigation/app_navigation.dart';
import 'package:ud_sass_app/core/widgets/components/loading.dart';
import 'package:ud_sass_app/ui/dashcn/components/button.dart';
import 'package:ud_sass_app/ui/dashcn/components/scaffold.dart';
import '../bloc/{{endpoint.blocFieldName}}_bloc.dart';
import '../service/{{module}}_service.dart';

class {{Module}}DeletePage extends StatelessWidget {
  const {{Module}}DeletePage({
    super.key,
    {{#endpoint.pathParams}}
    required this.{{name}},
    {{/endpoint.pathParams}}
  });

  {{#endpoint.pathParams}}
  final {{datatype}} {{name}};
  {{/endpoint.pathParams}}

  @override
  Widget build(BuildContext context) => BlocProvider<{{endpoint.OperationId}}Bloc>(
    create: (_) => {{endpoint.OperationId}}Bloc(
      {{Module}}Service(baseUrl: ProfileConstants.api),
    ),
    child: BlocListener<{{endpoint.OperationId}}Bloc,
        {{endpoint.OperationId}}State>(
      listener: (context, state) {
        if (state is {{endpoint.OperationId}}Success) {
          context.go('{{{basePath}}}');
        }
      },
      child: Scaffold(
        child: Center(
          child: BlocBuilder<{{endpoint.OperationId}}Bloc,
              {{endpoint.OperationId}}State>(
            builder: (context, state) {
              if (state is {{endpoint.OperationId}}Loading) {
                return const Loading();
              }
              if (state is {{endpoint.OperationId}}Error) {
                return Text(state.message);
              }
              if (state is {{endpoint.OperationId}}Success) {
                return const Text('Deleted successfully');
              }
              return Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Text('Delete this record?'),
                  const SizedBox(height: 12),
                  Button(
                    onPressed: () {
                      context.read<{{endpoint.OperationId}}Bloc>().add(
                        Load{{endpoint.OperationId}}Event({{{deleteBlocArgs}}}),
                      );
                    },
                    child: const Text('Delete'),
                  ),
                ],
              );
            },
          ),
        ),
      ),
    ),
  );
}
