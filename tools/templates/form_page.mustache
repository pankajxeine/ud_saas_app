class {{Module}}FormPage extends StatefulWidget {
  const {{Module}}FormPage({
    super.key,
    {{#updatePathParams}}
    this.{{name}},
    {{/updatePathParams}}
  });

  {{#updatePathParams}}
  final {{datatype}}? {{name}};
  {{/updatePathParams}}

  @override
  State<{{Module}}FormPage> createState() => _{{Module}}FormPageState();
}

class _{{Module}}FormPageState extends State<{{Module}}FormPage> {
  late reactive.EntityMeta _meta;
  late FormGroup _form;
  String? _message;
  bool _saving = false;

  {{#hasUpdateEndpoint}}
  bool get _isEditing => {{{updatePathGuard}}};
  {{/hasUpdateEndpoint}}

  @override
  void initState() {
    super.initState();
    _initializeForm();
  }

  void _initializeForm({Map<String, dynamic> initialValues = const {}}) {
    _meta = reactive.entityMetaFromJson(
      build{{Module}}FormSchema(initialValues: initialValues),
    );
    _form = _meta.toFormGroup(
      mode: {{#hasUpdateEndpoint}}_isEditing
          ? reactive.EntityMode.edit
          : {{/hasUpdateEndpoint}}reactive.EntityMode.create,
    );
  }

  @override
  void dispose() {
    _form.dispose();
    super.dispose();
  }

  Map<String, dynamic> _requestValues(Map<String, dynamic> values) {
    final requestValues = <String, dynamic>{...values};
    {{#formFields}}
    {{#isIntegerFormField}}
    requestValues['{{baseName}}'] = int.tryParse(
      values['{{baseName}}']?.toString() ?? '',
    );
    {{/isIntegerFormField}}
    {{#isDoubleFormField}}
    requestValues['{{baseName}}'] = double.tryParse(
      values['{{baseName}}']?.toString() ?? '',
    );
    {{/isDoubleFormField}}
    {{#isDynamicFormField}}
    final jsonValue{{name}} = values['{{baseName}}']?.toString() ?? '';
    requestValues['{{baseName}}'] = jsonValue{{name}}.isEmpty
        ? null
        : jsonDecode(jsonValue{{name}});
    {{/isDynamicFormField}}
    {{/formFields}}
    return requestValues;
  }

  void _submit(BuildContext context) {
    _form.markAllAsTouched();
    if (!_form.valid) return;

    setState(() {
      _saving = true;
      _message = null;
    });
    late final Map<String, dynamic> values;
    try {
      values = _requestValues(_form.value);
    } on FormatException {
      _handleSaveResult('Enter valid JSON for structured fields');
      return;
    }

    {{#hasUpdateEndpoint}}
    if (_isEditing) {
      final request = {{updateEndpoint.RequestClass}}.fromJson(values);
      context.read<{{updateEndpoint.OperationId}}Bloc>().add(
        Load{{updateEndpoint.OperationId}}Event({{{updateBlocArgs}}}),
      );
      return;
    }
    {{/hasUpdateEndpoint}}

    {{#hasCreateEndpoint}}
    final request = {{createEndpoint.RequestClass}}.fromJson(values);
    context.read<{{createEndpoint.OperationId}}Bloc>().add(
      Load{{createEndpoint.OperationId}}Event({{{createBlocArgs}}}),
    );
    {{/hasCreateEndpoint}}
  }

  void _handleSaveResult(String message) {
    if (!mounted) return;
    setState(() {
      _saving = false;
      _message = message;
    });
  }

  {{#hasDetailEndpoint}}
  void _handleDetailState(
    BuildContext context,
    {{detailEndpoint.OperationId}}State state,
  ) {
    if (state is {{detailEndpoint.OperationId}}Success) {
      final item = state.response.body;
      if (item == null) {
        _handleSaveResult('Record not found');
        return;
      }
      setState(() {
        _form.dispose();
        _initializeForm(initialValues: item.toJson());
      });
    }
  }
  {{/hasDetailEndpoint}}

  Widget _buildForm(BuildContext context) => ReactiveForm(
    formGroup: _form,
    child: Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        ReactiveShadcnForm(
          meta: _meta,
          form: _form,
          wrapWithReactiveForm: false,
        ),
        const SizedBox(height: 16),
        if (_message != null) ...[
          Text(_message!),
          const SizedBox(height: 12),
        ],
        ReactiveFormConsumer(
          builder: (context, form, child) => Align(
            alignment: Alignment.centerRight,
            child: Button(
              onPressed: _saving || form.disabled
                  ? null
                  : () => _submit(context),
              child: Text(
                _saving
                    ? 'Saving...'
                    : {{#hasUpdateEndpoint}}_isEditing ? 'Update' : {{/hasUpdateEndpoint}}'Create',
              ),
            ),
          ),
        ),
      ],
    ),
  );

  Widget _buildContent(BuildContext context) {
    {{#hasDetailEndpoint}}
    {{#hasUpdateEndpoint}}
    if (_isEditing) {
      return BlocConsumer<{{detailEndpoint.OperationId}}Bloc,
          {{detailEndpoint.OperationId}}State>(
        listener: _handleDetailState,
        builder: (context, state) {
          if (state is {{detailEndpoint.OperationId}}Loading) {
            return const Center(child: Loading());
          }
          if (state is {{detailEndpoint.OperationId}}Error) {
            return Center(child: Text(state.message));
          }
          return _buildForm(context);
        },
      );
    }
    {{/hasUpdateEndpoint}}
    {{/hasDetailEndpoint}}
    return _buildForm(context);
  }

  @override
  Widget build(BuildContext context) => MultiBlocProvider(
    providers: [
      {{#hasCreateEndpoint}}
      BlocProvider<{{createEndpoint.OperationId}}Bloc>(
        create: (_) => {{createEndpoint.OperationId}}Bloc(
          {{Module}}Service(baseUrl: ProfileConstants.api),
        ),
      ),
      {{/hasCreateEndpoint}}
      {{#hasUpdateEndpoint}}
      BlocProvider<{{updateEndpoint.OperationId}}Bloc>(
        create: (_) => {{updateEndpoint.OperationId}}Bloc(
          {{Module}}Service(baseUrl: ProfileConstants.api),
        ),
      ),
      {{/hasUpdateEndpoint}}
      {{#hasDetailEndpoint}}
      {{#hasUpdateEndpoint}}
      if (_isEditing)
        BlocProvider<{{detailEndpoint.OperationId}}Bloc>(
          create: (_) => {{detailEndpoint.OperationId}}Bloc(
            {{Module}}Service(baseUrl: ProfileConstants.api),
          )..add(
            Load{{detailEndpoint.OperationId}}Event({{{detailBlocArgs}}}),
          ),
        ),
      {{/hasUpdateEndpoint}}
      {{/hasDetailEndpoint}}
    ],
    child: MultiBlocListener(
      listeners: [
        {{#hasCreateEndpoint}}
        BlocListener<{{createEndpoint.OperationId}}Bloc,
            {{createEndpoint.OperationId}}State>(
          listener: (context, state) {
            if (state is {{createEndpoint.OperationId}}Success) {
              context.go('{{{basePath}}}');
            } else if (state is {{createEndpoint.OperationId}}Error) {
              _handleSaveResult(state.message);
            }
          },
        ),
        {{/hasCreateEndpoint}}
        {{#hasUpdateEndpoint}}
        BlocListener<{{updateEndpoint.OperationId}}Bloc,
            {{updateEndpoint.OperationId}}State>(
          listener: (context, state) {
            if (state is {{updateEndpoint.OperationId}}Success) {
              context.go('{{{basePath}}}');
            } else if (state is {{updateEndpoint.OperationId}}Error) {
              _handleSaveResult(state.message);
            }
          },
        ),
        {{/hasUpdateEndpoint}}
      ],
      child: Scaffold(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: SingleChildScrollView(child: _buildContent(context)),
        ),
      ),
    ),
  );
}
