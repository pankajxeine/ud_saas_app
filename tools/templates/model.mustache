class {{classname}} {
  {{#vars}}
  final {{datatype}} {{name}};
  {{/vars}}

  {{classname}}({
    {{#vars}}
    {{#modelRequired}}required {{/modelRequired}}this.{{name}},
    {{/vars}}
  });

  factory {{classname}}.fromJson(Map<String, dynamic> json) => {{classname}}(
    {{#vars}}
    {{name}}: json['{{baseName}}'] as {{castType}},
    {{/vars}}
  );

  Map<String, dynamic> toJson() => {
    {{#vars}}
    {{#modelRequired}}'{{baseName}}': {{name}},
    {{/modelRequired}}
    {{^modelRequired}}
    if ({{name}} != null) '{{baseName}}': {{name}},
    {{/modelRequired}}
    {{/vars}}
  };
}
