import 'package:flutter/material.dart' hide Scaffold, DataTable;
import 'package:flutter_bloc/flutter_bloc.dart';

import 'package:ud_sass_app/core/navigation/app_navigation.dart';
import 'package:ud_sass_app/ui/dashcn/components/button.dart';
import 'package:ud_sass_app/ui/dashcn/src/foundation/icons/bootstrap_icons.dart';
import 'package:ud_sass_app/ui/dashcn/components/scaffold.dart';
import 'package:ud_sass_app/core/widgets/common/app_page_header.dart';
import 'package:ud_sass_app/core/widgets/common/responsive_card_view.dart';
import 'package:ud_sass_app/core/widgets/data_table/data_table.dart';
import 'package:ud_sass_app/core/config/environment.dart';
import 'package:ud_sass_app/core/widgets/components/loading.dart';
{{#endpoint}}
import '../service/{{moduleName}}_service.dart';
import '../bloc/{{blocFieldName}}_bloc.dart';
import '../model/{{ResponseModelFile}}.dart';
{{/endpoint}}

class {{Module}}Page extends StatelessWidget {
  const {{Module}}Page({super.key});

  @override
  Widget build(BuildContext context) {
    {{#endpoint}}
    return BlocProvider<{{endpoint.OperationId}}Bloc>(
      create: (_) => {{endpoint.OperationId}}Bloc(
        {{endpoint.serviceName}}Service(baseUrl: ProfileConstants.api),
      )..add(Load{{endpoint.OperationId}}Event()),
      child: Scaffold(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              const AppPageHeader(
                title: '{{pageTitle}}',
                breadcrumbs: const [],
              ),
              const SizedBox(height: 16),
              Expanded(
                child: BlocBuilder<{{endpoint.OperationId}}Bloc, {{endpoint.OperationId}}State>(
                  builder: (context, state) {
                    switch (state) {
                      case {{endpoint.OperationId}}Initial():
                        return const Center(child: Text('Initial state'));
                      case {{endpoint.OperationId}}Loading():
                        return const Center(child: Loading());
                      case {{endpoint.OperationId}}Error(:final message):
                        return Center(child: Text(message));
                      case {{endpoint.OperationId}}Success(:final response):
                        final items = response.body?.data ??
                            const <{{ResponseClass}}>[];
                        final columns = <TrinaColumn>[
                          {{#columns}}
                          TrinaColumn(
                            title: '{{baseName}}',
                            field: '{{baseName}}',
                            type: {{#isNumeric}}TrinaColumnType.number(){{/isNumeric}}{{^isNumeric}}TrinaColumnType.text(){{/isNumeric}},
                          ),
                          {{/columns}}
                        ];
                        final List<TrinaRow<dynamic>> rows = items
                            .map<TrinaRow<dynamic>>(
                              (item) => TrinaRow(
                                cells: {
                                  {{#columns}}
                                  '{{baseName}}': TrinaCell(value: item.{{name}}),
                                  {{/columns}}
                                },
                              ),
                            )
                            .toList(growable: false);

                        return LayoutBuilder(
                          builder: (context, constraints) {
                            if (constraints.maxWidth < 600) {
                              return ResponsiveCardView<{{ResponseClass}}>(
                                items: items,
                                titleBuilder: (item) => {{#hasCardTitleField}}{{#cardTitleNullable}}
                                    item.{{cardTitleField}}?.toString() ?? 'Record',
                                    {{/cardTitleNullable}}{{^cardTitleNullable}}item.{{cardTitleField}}.toString(),
                                    {{/cardTitleNullable}}
                                    {{/hasCardTitleField}}{{^hasCardTitleField}}'Record',{{/hasCardTitleField}}
                                {{#hasCardSubtitle}}
                                subtitleBuilder: (item) =>
                                    {{#cardSubtitleNullable}}item.{{cardSubtitleField}}?.toString(){{/cardSubtitleNullable}}{{^cardSubtitleNullable}}item.{{cardSubtitleField}}.toString(){{/cardSubtitleNullable}},
                                {{/hasCardSubtitle}}
                                fieldsBuilder: (item) => [
                                  {{#columns}}
                                  ResponsiveCardField(
                                    label: '{{baseName}}',
                                    {{#isNullable}}
                                    value: item.{{name}}?.toString() ?? '-',
                                    {{/isNullable}}{{^isNullable}}
                                    value: item.{{name}}.toString(),
                                    {{/isNullable}}
                                  ),
                                  {{/columns}}
                                ],
                                {{#hasDetailPage}}
                                onView: (item) {
                                  {{#detailRouteGuard}}
                                  if ({{detailRouteGuard}}) return;
                                  {{/detailRouteGuard}}
                                  context.go({{{detailRouteExpression}}});
                                },
                                {{/hasDetailPage}}
                                {{#hasFormPage}}
                                onEdit: (item) {
                                  {{#editRouteGuard}}
                                  if ({{editRouteGuard}}) return;
                                  {{/editRouteGuard}}
                                  context.go({{{editRouteExpression}}});
                                },
                                {{/hasFormPage}}
                              );
                            }
                            return DataTable(
                              columns: columns,
                              rows: rows,
                              {{#hasCreatePage}}
                              headerActionsBuilder: (context, compact) => Button(
                                size: compact ? ButtonSize.icon : ButtonSize.sm,
                                onPressed: () => context.go('{{{basePath}}}/new'),
                                leading: compact
                                    ? null
                                    : const Icon(BootstrapIcons.plus, size: 16),
                                child: compact
                                    ? const Icon(BootstrapIcons.plus, size: 18)
                                    : const Text('Add'),
                              ),
                              {{/hasCreatePage}}
                              {{#hasDetailPage}}
                              onRowTap: (rowIdx) {
                                final item = items[rowIdx];
                                {{#detailRouteGuard}}
                                if ({{detailRouteGuard}}) return;
                                {{/detailRouteGuard}}
                                context.go({{{detailRouteExpression}}});
                              },
                              {{/hasDetailPage}}
                              {{#hasFormPage}}
                              onRowEdit: (rowIdx) {
                                final item = items[rowIdx];
                                {{#editRouteGuard}}
                                if ({{editRouteGuard}}) return;
                                {{/editRouteGuard}}
                                context.go({{{editRouteExpression}}});
                              },
                              {{/hasFormPage}}
                            );
                          },
                        );
                    }
                    return const SizedBox.shrink();
                  },
                ),
              ),
            ],
          ),
        ),
      ),
    );
    {{/endpoint}}
  }
}
